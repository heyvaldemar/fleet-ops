# The Python packages the workflows install, pinned to one version each.
# requirements.txt is compiled from this file with hashes and is what the
# workflows actually install; edit here, then regenerate it:
#
#   docker run --rm -v "$PWD:/w" -w /w python:3.12 sh -c \
#     'pip install --quiet pip-tools && pip-compile --quiet --generate-hashes --strip-extras requirements.in'
#
# Dependabot knows this pair (pip-compile input and output) and recompiles
# the lock when it raises a bump, so the hashes move with the version.
#
# The Anthropic SDK, for upstream-review.py, fleet-scout.py and the triage.
anthropic==1.11.0
# verify.yml: pyflakes reads every script for undefined names, pyyaml lets
# test-split-freshness.sh compare workflows as data.
pyflakes==4.0.2
pyyaml==6.0.3
